# Majalis Al-Elm Platform — Environment Variables
#
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file with real secrets.
# .env.local is in .gitignore.
#
# For JWT keys, run:
#   bash scripts/gen-jwt-keys.sh
# This generates secrets/jwt_private_key.pem and secrets/jwt_public_key.pem
# and prints the inline env vars for environments that don't support file mounts.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=majalis-elm-backend

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=majaliselm
DATABASE_USER=majaliselm
DATABASE_PASSWORD=<REPLACE_WITH_SECURE_PASSWORD>
DATABASE_SSL=false

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# REQUIRED — the server REFUSES TO START without a real RS256 key pair in every
# environment except NODE_ENV=test (POLICY-SEC-001 / TECH-DEBT-013). There is no
# fallback secret: a missing key is a boot failure, never a weaker algorithm.
# Provide BOTH halves (private + public), via Option A or Option B.
#
# Option A: File paths (recommended for Docker — maps to container secrets)
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public_key.pem

# Option B: Inline keys (for environments without file mounts, e.g. CI, Railway)
# Paste the PEM content with \n replacing actual newlines.
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----

# Access token TTL in seconds (default: 900 = 15 minutes)
JWT_ACCESS_TOKEN_TTL=900
# Refresh token TTL in seconds (default: 604800 = 7 days)
JWT_REFRESH_TOKEN_TTL=604800

# ── Object Storage (ADR-013) ──────────────────────────────────────────────────
# REQUIRED — like the JWT keys above, the server REFUSES TO START without a
# reachable object store in every environment except NODE_ENV=test. Media upload
# is a core capability; there is no "uploads disabled" mode to degrade into.
# Three checks run at boot: Joi (present + well-formed), assertStorageIntegrity()
# (values safe for this NODE_ENV), and a live HeadBucket call (bucket exists and
# answers to these credentials).
#
# Local development: `docker compose up -d minio` creates the bucket for you.
# The compose file reads S3_ACCESS_KEY / S3_SECRET_KEY as MinIO's root
# credentials, so these two values configure both sides at once.

# The address THIS PROCESS uses.
#   Backend running on the host (nx serve):  http://localhost:9000
#   Backend running inside compose:          http://minio:9000  (set in compose)
S3_ENDPOINT=http://localhost:9000

# The address the BROWSER uses, and therefore the host presigned URLs are signed
# against. Only needed when it differs from S3_ENDPOINT — which is the case when
# the backend runs inside compose (minio:9000) and the admin app runs on the host
# (localhost:9000). SigV4 signs the Host header, so a signed URL cannot be
# rewritten afterwards. Leave commented out when both are the same, as on R2.
# S3_PUBLIC_BASE_URL=http://localhost:9000

# SigV4 mixes the region into the signing key, so this must match the server.
#   MinIO: us-east-1     Cloudflare R2: auto     AWS: the bucket's real region
S3_REGION=us-east-1

S3_BUCKET_NAME=majalis-elm-media

# Local-only credentials. The "local-dev-only" marker is rejected outright under
# NODE_ENV=production/staging, so copying this file to a server fails loudly at
# boot instead of guarding all platform media with a value published on GitLab.
S3_ACCESS_KEY=majaliselm-local-dev-only
S3_SECRET_KEY=majaliselm-local-dev-only-secret-key

# MinIO container port mappings (compose only; change if 9000/9001 are taken).
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Origins allowed to send presigned uploads straight to the bucket. The admin app
# uploads from the browser, so its origin must be listed or the CORS preflight
# fails and no upload can start. Mirror this as a CORS policy on the R2 bucket.
S3_CORS_ALLOW_ORIGIN=http://localhost,http://localhost:4200,http://localhost:5173

# ── Switching to Cloudflare R2 (before deployment) ───────────────────────────
# Code change required: none. Replace the five values above and restart:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY=<R2 Access Key ID>
#   S3_SECRET_KEY=<R2 Secret Access Key>
#   S3_BUCKET_NAME=<R2 bucket name>
# then drop S3_PUBLIC_BASE_URL, S3_PORT, S3_CONSOLE_PORT and the minio services
# from docker-compose.yml. Under NODE_ENV=production, https is mandatory and a
# loopback endpoint is refused.

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Leave empty to disable CORS (not recommended for production).
CORS_ORIGIN=http://localhost,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Global default — per-endpoint overrides are set in controllers via @Throttle()
THROTTLE_TTL=60000
THROTTLE_LIMIT=200

# ── Logging ───────────────────────────────────────────────────────────────────
# Valid values: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Set to true for human-readable pretty-print output in development
LOG_PRETTY=true

# Media processing is intentionally off until the FFmpeg worker is deployed.
MEDIA_TRANSCODE_ENABLED=false

# ── Queue (ADR-013 Stage B — BullMQ) ──────────────────────────────────────────
# REQUIRED — the server REFUSES TO START without this outside NODE_ENV=test.
# BullMQ needs a Redis-compatible connection to run the transcode queue.
# Local development: `docker compose up -d redis` if the compose file defines
# one, or point at any local Redis (`redis-cli ping` should return PONG).
# Production: Upstash Redis (the sponsor's decision — see ADR-013) or any
# managed Redis. Use `rediss://` (TLS) in production, `redis://` locally.
REDIS_URL=redis://localhost:6379

